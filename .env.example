# Environment Variables Example for Astro Predictions

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Local AI Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_GENERATION=gemma4
AI_MODEL_VALIDATION=qwen3.5

# Ephemeris & Geocoding
EPHEMERIS_PATH=./data/ephemeris
GEONAMES_USERNAME=your_geonames_username

# Free-Tier Rate Limits & Governance
FREE_DAILY_CHARTS=10
FREE_DAILY_AI_REPORTS=3
FREE_DAILY_AI_MESSAGES=20
