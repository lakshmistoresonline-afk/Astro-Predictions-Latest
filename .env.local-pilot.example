# Astrovision Live Real-User Local Pilot Profile Environment
# Copy to .env.local-pilot and configure with real strong production keys!

ENVIRONMENT=production

# Host Binding & Network Endpoints
# LAN Testing: Set ASTROVISION_HOST_IP to your machine's local IPv4 (e.g. 192.168.1.100)
ASTROVISION_HOST_IP=192.168.1.100
NEXT_PUBLIC_API_URL=http://192.168.1.100:8000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000,https://astrovision.io

# Mandatory Production Security Secrets (Minimum 16 characters!)
ADMIN_API_KEY=pilot_admin_secret_key_9876543210_prod
JWT_SECRET_KEY=pilot_jwt_signing_secret_key_123456789_prod

# Relational Database Connection (SQLite File Database / Option 3)
DATABASE_URL=sqlite:///./astrovision.db

# AI Provider Configuration (openai | gemini | ollama)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Gemini Configuration (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Ollama Configuration (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
ALLOW_LOCAL_OLLAMA_IN_PRODUCTION=true
AI_MODEL_GENERATION=gemma4
AI_MODEL_VALIDATION=qwen3.5
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2

# Free-Tier Governance Limits for Pilot Users
FREE_DAILY_CHARTS=10
FREE_DAILY_AI_REPORTS=3
FREE_DAILY_AI_MESSAGES=20
